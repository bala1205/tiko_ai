rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only owner can read/write own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Conversations: ownership enforced via userId field
    match /conversations/{convId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Messages subcollection: user must own parent conversation
      match /messages/{messageId} {
        allow read, create: if request.auth != null && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid;
        // Users should not update/delete others' messages; allow update only if owner
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid;
      }
    }
  }
}
